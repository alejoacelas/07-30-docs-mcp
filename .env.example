# Optional operator backup only. The remote server does not read these values.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional override for the local token store.
# DOCS_MCP_TOKEN_FILE=/absolute/path/to/token.json

# Canonical public URL for a non-Vercel remote deployment.
# DOCS_MCP_PUBLIC_ORIGIN=https://docs-mcp.example.org
