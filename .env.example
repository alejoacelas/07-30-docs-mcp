# Required by organization-owned broker mode.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
MCP_OAUTH_CLIENT_ID=claude-organization-docs-mcp
MCP_OAUTH_CLIENT_SECRET=generate-a-random-secret
MCP_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
DOCS_MCP_TOKEN_KEY=generate-32-random-bytes-as-base64url
DOCS_MCP_PUBLIC_ORIGIN=https://docs-mcp.example.org
DOCS_MCP_AUTH_MODE=broker
UPSTASH_REST_URL=https://example.upstash.io
UPSTASH_REST_TOKEN=your-upstash-rest-token

# Optional override for the local token store.
# DOCS_MCP_TOKEN_FILE=/absolute/path/to/token.json
